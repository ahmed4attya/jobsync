generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  createdAt        DateTime          @default(now())
  defaultResumeId  String?
  Activity         Activity[]
  ActivityType     ActivityType[]
  ApiKey           ApiKey[]
  Application      Application[]
  Automation       Automation[]
  ChatConversation ChatConversation?
  Company          Company[]
  Contact          Contact[]
  ContactRole      ContactRole[]
  jobsApplied      Job[]
  JobSource        JobSource[]
  JobTitle         JobTitle[]
  Location         Location[]
  McpAccessToken   McpAccessToken[]
  Note             Note[]
  Profile          Profile[]
  Question         Question[]
  Tag              Tag[]
  Task             Task[]
  defaultResume    Resume?           @relation("UserDefaultResume", fields: [defaultResumeId], references: [id])
  Settings         UserSettings?
}

model ApiKey {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  encryptedKey String
  iv           String
  last4        String
  label        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([userId])
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Profile {
  id           String        @id @default(uuid())
  userId       String
  coverLetters CoverLetter[]
  user         User          @relation(fields: [userId], references: [id])
  resumes      Resume[]
}

model Resume {
  id             String          @id @default(uuid())
  profileId      String
  title          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  FileId         String?         @unique
  reviewData     String?
  Automation     Automation[]
  Applications   Application[]
  ContactInfo    ContactInfo?
  Job            Job[]
  File           File?           @relation(fields: [FileId], references: [id])
  profile        Profile         @relation(fields: [profileId], references: [id])
  ResumeSections ResumeSection[]
  defaultForUser User[]          @relation("UserDefaultResume")
}

model CoverLetter {
  id        String   @id @default(uuid())
  profileId String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id])
  Job       Job[]
  Applications Application[]
}

model File {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileType   String
  uploadedAt DateTime @default(now())
  Resume     Resume?
}

model ResumeSection {
  id                      String                   @id @default(uuid())
  resumeId                String
  sectionTitle            String
  sectionType             String
  summaryId               String?                  @unique
  educations              Education[]
  licenseOrCertifications LicenseOrCertification[]
  others                  OtherSection[]
  Resume                  Resume                   @relation(fields: [resumeId], references: [id])
  summary                 Summary?                 @relation(fields: [summaryId], references: [id])
  skills                  Skill[]
  workExperiences         WorkExperience[]
}

model ContactInfo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumeId  String   @unique
  firstName String
  lastName  String
  headline  String
  email     String
  phone     String
  address   String?
  url1      String?
  url2      String?
  url1Label String?
  url2Label String?
  resume    Resume   @relation(fields: [resumeId], references: [id])
}

model Summary {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  content       String
  ResumeSection ResumeSection?
}

model WorkExperience {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  companyId       String
  jobTitleId      String
  startDate       DateTime
  endDate         DateTime?
  description     String
  locationId      String
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
  location        Location       @relation(fields: [locationId], references: [id])
  jobTitle        JobTitle       @relation(fields: [jobTitleId], references: [id])
  Company         Company        @relation(fields: [companyId], references: [id])
}

model Education {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  institution     String
  degree          String
  fieldOfStudy    String
  startDate       DateTime
  endDate         DateTime?
  description     String?
  locationId      String
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
  location        Location       @relation(fields: [locationId], references: [id])
}

model LicenseOrCertification {
  id              String         @id @default(uuid())
  title           String
  organization    String
  issueDate       DateTime?
  expirationDate  DateTime?
  credentialUrl   String?
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
}

model OtherSection {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  title           String
  content         String
  resumeSectionId String?
  ResumeSection   ResumeSection? @relation(fields: [resumeSectionId], references: [id])
}

model Contact {
  id                String       @id @default(uuid())
  name              String
  title             String?
  email             String?
  phone             String?
  linkedinUrl       String?
  companyId         String?
  locationId        String?
  relationship      String?
  workedAtCompanyId String?
  workedFrom        DateTime?
  workedTo          DateTime?
  roleId            String?
  notes             String?
  lastContactedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdBy         String
  interviewId       String?
  Interview         Interview?   @relation(fields: [interviewId], references: [id])
  user              User         @relation(fields: [createdBy], references: [id])
  Role              ContactRole? @relation(fields: [roleId], references: [id])
  WorkedAtCompany   Company?     @relation("ContactWorkedAt", fields: [workedAtCompanyId], references: [id])
  Location          Location?    @relation(fields: [locationId], references: [id])
  Company           Company?     @relation("ContactCompany", fields: [companyId], references: [id])
  jobLinks          JobContact[]

  @@index([createdBy])
  @@index([companyId])
  @@index([workedAtCompanyId])
  @@index([roleId])
}

model ContactRole {
  id          String       @id @default(uuid())
  label       String
  value       String
  createdBy   String
  contacts    Contact[]
  user        User         @relation(fields: [createdBy], references: [id])
  jobContacts JobContact[]

  @@unique([value, createdBy])
}

model JobContact {
  id        String      @id @default(uuid())
  jobId     String
  contactId String
  roleId    String
  createdAt DateTime    @default(now())
  Role      ContactRole @relation(fields: [roleId], references: [id])
  Contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, contactId, roleId])
  @@index([contactId])
}

model JobTitle {
  id              String           @id @default(uuid())
  label           String
  value           String
  createdBy       String
  jobs            Job[]
  user            User             @relation(fields: [createdBy], references: [id])
  workExperiences WorkExperience[]

  @@unique([value, createdBy])
}

model JobStatus {
  id    String @id @default(uuid())
  label String
  value String @unique
  jobs  Job[]
}

model Location {
  id             String           @id @default(uuid())
  label          String
  value          String
  stateProv      String?
  country        String?
  createdBy      String
  contacts       Contact[]
  educations     Education[]
  jobsApplied    Job[]
  user           User             @relation(fields: [createdBy], references: [id])
  workExperience WorkExperience[]

  @@unique([value, createdBy])
}

model Company {
  id               String           @id @default(uuid())
  label            String
  value            String
  logoUrl          String?
  createdBy        String
  watched          Boolean          @default(false)
  watchedAt        DateTime?
  atsProvider      String?
  atsToken         String?
  atsHost          String?
  websiteUrl       String?
  careersUrl       String?
  industry         String?
  user             User             @relation(fields: [createdBy], references: [id])
  formerColleagues Contact[]        @relation("ContactWorkedAt")
  contacts         Contact[]        @relation("ContactCompany")
  jobsApplied      Job[]
  workExperiences  WorkExperience[]
  applySettings    CompanyApplySettings?

  @@unique([value, createdBy])
  @@unique([createdBy, atsProvider, atsToken])
  @@index([createdBy, watched])
}

model JobSource {
  id          String @id @default(uuid())
  label       String
  value       String
  createdBy   String
  jobsApplied Job[]
  user        User   @relation(fields: [createdBy], references: [id])

  @@unique([value, createdBy])
}

model Interview {
  id           String    @id @default(uuid())
  createdAt    DateTime
  jobId        String
  interviewers Contact[]
  job          Job       @relation(fields: [jobId], references: [id])
}

model Job {
  id                      String       @id @default(uuid())
  userId                  String
  jobUrl                  String?
  description             String
  jobType                 String
  createdAt               DateTime
  applied                 Boolean      @default(false)
  appliedDate             DateTime?
  dueDate                 DateTime?
  statusId                String
  jobTitleId              String
  companyId               String
  jobSourceId             String?
  salaryRange             String?
  locationId              String?
  resumeId                String?
  coverLetterId           String?
  automationId            String?
  matchScore              Int?
  matchData               String?
  discoveryStatus         String?
  discoveredAt            DateTime?
  createdVia              String?
  workplaceType           String?
  descriptionCompleteness String?
  Interview               Interview[]
  automation              Automation?  @relation(fields: [automationId], references: [id])
  CoverLetter             CoverLetter? @relation(fields: [coverLetterId], references: [id])
  Resume                  Resume?      @relation(fields: [resumeId], references: [id])
  Location                Location?    @relation(fields: [locationId], references: [id])
  JobSource               JobSource?   @relation(fields: [jobSourceId], references: [id])
  Company                 Company      @relation(fields: [companyId], references: [id])
  JobTitle                JobTitle     @relation(fields: [jobTitleId], references: [id])
  Status                  JobStatus    @relation(fields: [statusId], references: [id])
  User                    User         @relation(fields: [userId], references: [id])
  Applications            Application[]
  contactLinks            JobContact[]
  Notes                   Note[]
  tags                    Tag[]        @relation("JobToTag")

  @@index([userId, automationId])
  @@index([userId, discoveryStatus])
}

model ActivityType {
  id          String     @id @default(uuid())
  label       String
  value       String
  description String?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Activities  Activity[]
  user        User       @relation(fields: [createdBy], references: [id])
  Tasks       Task[]

  @@unique([value, createdBy])
}

model Activity {
  id               String       @id @default(uuid())
  userId           String
  activityName     String
  startTime        DateTime
  endTime          DateTime?
  duration         Int?
  breakMinutes     Int          @default(0)
  breakStartedAt   DateTime?
  breakPlannedMins Int?
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  activityTypeId   String
  taskId           String?
  task             Task?        @relation(fields: [taskId], references: [id])
  activityType     ActivityType @relation(fields: [activityTypeId], references: [id])
  User             User         @relation(fields: [userId], references: [id])
}

model Task {
  id              String        @id @default(uuid())
  userId          String
  title           String
  description     String?
  status          String        @default("in-progress")
  priority        Int           @default(5)
  percentComplete Int           @default(0)
  dueDate         DateTime?
  activityTypeId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activities      Activity[]
  activityType    ActivityType? @relation(fields: [activityTypeId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, activityTypeId])
  @@index([userId, dueDate])
}

model Automation {
  id             String          @id @default(uuid())
  userId         String
  name           String
  jobBoard       String
  keywords       String
  location       String
  resumeId       String
  matchThreshold Int             @default(80)
  scheduleHour   Int
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sourceConfig   String?
  resume         Resume          @relation(fields: [resumeId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  runs           AutomationRun[]
  discoveredJobs Job[]

  @@index([userId])
  @@index([status, nextRunAt])
}

model AutomationRun {
  id               String     @id @default(uuid())
  automationId     String
  jobsSearched     Int        @default(0)
  jobsDeduplicated Int        @default(0)
  jobsProcessed    Int        @default(0)
  jobsMatched      Int        @default(0)
  jobsSaved        Int        @default(0)
  status           String     @default("running")
  errorMessage     String?
  blockedReason    String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  funnelStats      String?
  automation       Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([startedAt])
}

model Note {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
}

model Tag {
  id        String     @id @default(uuid())
  label     String
  value     String
  createdBy String
  skills    Skill[]
  user      User       @relation(fields: [createdBy], references: [id])
  jobs      Job[]      @relation("JobToTag")
  questions Question[] @relation("QuestionToTag")

  @@unique([value, createdBy])
}

model Skill {
  id              String        @id @default(uuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        String?
  order           Int           @default(0)
  tagId           String
  resumeSectionId String
  ResumeSection   ResumeSection @relation(fields: [resumeSectionId], references: [id])
  Tag             Tag           @relation(fields: [tagId], references: [id])

  @@index([resumeSectionId])
}

model Question {
  id         String   @id @default(uuid())
  question   String
  answer     String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdVia String?
  user       User     @relation(fields: [createdBy], references: [id])
  tags       Tag[]    @relation("QuestionToTag")

  @@index([createdBy])
}

model McpAccessToken {
  id          String    @id @default(uuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String
  expiresAt   DateTime
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String   @unique
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Apply-engine models. SQLite has no Prisma enums, so enum-like values are
// documented strings (project convention, like Job.discoveryStatus):
//   Application.status: DRAFT | READY_REVIEW | SUBMITTED | FAILED | SKIPPED_MANUAL
//   Application.submissionMode: MANUAL_CONFIRM | AUTO
//   ApplicationEvent.type: EXTRACTED | FILLED | UPLOAD | CONFIRM_WAIT | SUBMITTED | FAILED | CAPTCHA_FALLBACK | DRY_RUN
model Application {
  id              String             @id @default(uuid())
  userId          String
  jobId           String
  resumeId        String?
  coverLetterId   String?
  sourceUrl       String
  atsProvider     String?
  status          String             @default("DRAFT")
  submissionMode  String             @default("MANUAL_CONFIRM")
  fieldCoverage   Float?
  uniqueApplyKey  String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  User            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  Job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  Resume          Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  CoverLetter     CoverLetter?       @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  events          ApplicationEvent[]

  @@index([userId])
  @@index([jobId])
  @@index([userId, status])
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  type          String
  payload       Json?
  createdAt     DateTime    @default(now())
  Application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, type])
}

model CompanyApplySettings {
  companyId        String    @id
  autoApplyEnabled Boolean   @default(false)
  dryRunsCompleted Int       @default(0)
  dailyCap         Int       @default(5)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  Company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
